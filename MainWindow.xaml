                                                    <TextBlock x:Name="LblCloseOnLeaveSub" Text="Автоматически сворачивать остров, когда курсор уходит в сторону" Foreground="{DynamicResource ThemeMutedBrush}" FontSize="11" TextWrapping="Wrap"/>
                                                </StackPanel>
                                                <CheckBox x:Name="TglCloseOnLeave" Style="{StaticResource IslandSwitch}" IsChecked="True" HorizontalAlignment="Right" VerticalAlignment="Center" Click="SaveSettings_Click"/>
                                            </Grid>

                                            <Grid Margin="0,0,0,12">
                                                <TextBlock x:Name="LblRememberDashboardTab" Text="Запоминать последнюю вкладку"
                                                           Foreground="{DynamicResource ThemeTextBrush}" FontSize="13" VerticalAlignment="Center"
                                                           Margin="0,0,60,0" TextWrapping="Wrap"/>
                                                <CheckBox x:Name="TglRememberDashboardTab" Style="{StaticResource IslandSwitch}"
                                                          HorizontalAlignment="Right" VerticalAlignment="Center"
                                                          AutomationProperties.LabeledBy="{Binding ElementName=LblRememberDashboardTab}"
                                                          Click="TglRememberDashboardTab_Click"/>
                                            </Grid>

                                            <Grid Margin="0,0,0,12">
                                                <StackPanel Margin="0,0,60,0">
                                                    <TextBlock x:Name="LblPinPos" Text="Закрепить на месте (не перетаскивать)" Foreground="{DynamicResource ThemeTextBrush}" FontSize="13" FontWeight="SemiBold"/>
                                                    <TextBlock x:Name="LblPinPosSub" Text="Выключите, чтобы свободно перетаскивать остров по верху" Foreground="{DynamicResource ThemeMutedBrush}" FontSize="11"/>
                                                </StackPanel>
                                                <CheckBox x:Name="TglPinPosition" Style="{StaticResource IslandSwitch}" IsChecked="False" HorizontalAlignment="Right" Click="PinIsland_Click"/>
                                            </Grid>

                                            <Grid Margin="0,0,0,12">
                                                <StackPanel Margin="0,0,60,0">
                                                    <TextBlock Text="У верхнего края (macOS)" Foreground="{DynamicResource ThemeTextBrush}" FontSize="13" FontWeight="SemiBold"/>
                                                    <TextBlock Text="Выключено — плавающая капсула. Включено — остров у верхнего края экрана." Foreground="{DynamicResource ThemeMutedBrush}" FontSize="11" TextWrapping="Wrap"/>
                                                </StackPanel>
                                                <CheckBox x:Name="TglDockIsland" Style="{StaticResource IslandSwitch}" HorizontalAlignment="Right" VerticalAlignment="Center" Click="DockIsland_Click"/>
                                            </Grid>

                                            <Grid Margin="0,0,0,12">
                                                <TextBlock x:Name="LblCaps" Text="Показывать Caps Lock" Foreground="{DynamicResource ThemeTextBrush}" FontSize="13" VerticalAlignment="Center"/>
                                                <CheckBox x:Name="TglShowCapsLock" Style="{StaticResource IslandSwitch}" IsChecked="True" HorizontalAlignment="Right" Click="SaveSettings_Click"/>
                                            </Grid>

                                            <Grid Margin="0,0,0,12">
                                                <TextBlock x:Name="LblNumLock" Text="Показывать Num Lock" Foreground="{DynamicResource ThemeTextBrush}" FontSize="13" VerticalAlignment="Center"/>
                                                <CheckBox x:Name="TglShowNumLock" Style="{StaticResource IslandSwitch}" IsChecked="True" HorizontalAlignment="Right" Click="SaveSettings_Click"/>
                                            </Grid>

                                            <Grid Margin="0,0,0,12">
                                                <TextBlock x:Name="LblLayout" Text="Показывать смену раскладки" Foreground="{DynamicResource ThemeTextBrush}" FontSize="13" VerticalAlignment="Center"/>
                                                <CheckBox x:Name="TglShowLayout" Style="{StaticResource IslandSwitch}" IsChecked="True" HorizontalAlignment="Right" Click="SaveSettings_Click"/>
                                            </Grid>

                                            <!-- 1. ЗВОНОК DISCORD — ОТДЕЛЬНЫМ ОСТРОВКОМ СПРАВА -->
                                            <Grid Margin="0,0,0,12">
                                                <StackPanel Margin="0,0,60,0">
                                                    <TextBlock x:Name="LblDiscordRight" Text="Звонок Discord — отдельным островком справа" Foreground="{DynamicResource ThemeTextBrush}" FontSize="13" FontWeight="SemiBold"/>
                                                    <TextBlock x:Name="LblDiscordRightSub" Text="Отображается отдельным островком справа даже во время игрового режима" Foreground="{DynamicResource ThemeMutedBrush}" FontSize="11" TextWrapping="Wrap"/>
                                                </StackPanel>
                                                <CheckBox x:Name="TglDiscordCallRight" Style="{StaticResource IslandSwitch}" IsChecked="True" HorizontalAlignment="Right" VerticalAlignment="Center" Click="TglDiscordCallRight_Click"/>
                                            </Grid>

                                            <!-- 2. ИГРОВОЙ РЕЖИМ (БЕЗ КНОПКИ ВКЛ/ВЫКЛ — ТОЛЬКО ТУМБЛЕР) -->
                                            <Grid Margin="0,0,0,12">
                                                <StackPanel Margin="0,0,55,0" VerticalAlignment="Center">
                                                    <TextBlock x:Name="LblExternalProgress" Text="Прогресс других программ справа" Foreground="{DynamicResource ThemeTextBrush}" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                                    <TextBlock x:Name="LblExternalProgressSub" Text="Отдельная капсула, не закрывающая часы и погоду" Foreground="{DynamicResource ThemeMutedBrush}" FontSize="11" TextWrapping="Wrap"/>
                                                </StackPanel>
                                                <CheckBox x:Name="TglExternalProgress" Style="{StaticResource IslandSwitch}" IsChecked="True" HorizontalAlignment="Right" Click="TglExternalProgress_Click"/>
                                            </Grid>

                                            <Grid Margin="0,0,0,12">
                                                <StackPanel Margin="0,0,60,0">
                                                    <TextBlock x:Name="LblGameModeHud" Text="Игровой режим (Показ FPS, CPU, °C, GPU)" Foreground="{DynamicResource ThemeTextBrush}" FontSize="13" FontWeight="SemiBold"/>
                                                    <TextBlock x:Name="LblGameModeHudSub" Text="Во время игрового режима включается «Не беспокоить» и уведомления не приходят (кроме звонка Discord справа)" Foreground="{DynamicResource ThemeMutedBrush}" FontSize="10.5" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                                </StackPanel>
                                                <CheckBox x:Name="TglGameModeHud" Style="{StaticResource IslandSwitch}" IsChecked="False" HorizontalAlignment="Right" VerticalAlignment="Center" Click="TglGameModeHud_Click"/>
                                            </Grid>

                                            <!-- 3. СООБЩЕНИЯ TELEGRAM, DISCORD, VIBER... НА ОСТРОВКЕ -->
                                            <Grid Margin="0,0,0,12">
                                                <StackPanel Margin="0,0,60,0">
                                                    <TextBlock x:Name="LblMessengerNotifs" Text="Сообщения Telegram, exDesktop, Discord, Viber…" Foreground="{DynamicResource ThemeTextBrush}" FontSize="13" FontWeight="SemiBold"/>
                                                    <TextBlock x:Name="LblMessengerNotifsSub" Text="Перехватывает уведомления мессенджеров и выводит их прямо в островок" Foreground="{DynamicResource ThemeMutedBrush}" FontSize="10.5" TextWrapping="Wrap"/>
                                                    <TextBlock Text="В Telegram и exDesktop нужно включить системные уведомления Windows." Foreground="{DynamicResource ThemeMutedBrush}" FontSize="10.5" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                                </StackPanel>
                                                <CheckBox x:Name="TglMessengerNotifs" Style="{StaticResource IslandSwitch}" IsChecked="True" HorizontalAlignment="Right" VerticalAlignment="Center" Click="TglNotificationHooks_Click"/>
                                            </Grid>

                                            <!-- 4. УВЕДОМЛЕНИЯ ВСЕХ ПРИЛОЖЕНИЙ, НЕ ТОЛЬКО МЕССЕНДЖЕРОВ -->
                                            <Grid Margin="0,0,0,12">
                                                <StackPanel Margin="0,0,60,0">
                                                    <TextBlock x:Name="LblAllAppNotifs" Text="Уведомления всех приложений, не только мессенджеров" Foreground="{DynamicResource ThemeTextBrush}" FontSize="13" FontWeight="SemiBold"/>
                                                    <TextBlock x:Name="LblAllAppNotifsSub" Text="В Telegram Desktop включите «Настройки → Уведомления → Системные уведомления»" Foreground="{DynamicResource ThemeMutedBrush}" FontSize="10.5" TextWrapping="Wrap"/>
                                                </StackPanel>
                                                <CheckBox x:Name="TglAllAppNotifs" Style="{StaticResource IslandSwitch}" IsChecked="False" HorizontalAlignment="Right" VerticalAlignment="Center" Click="TglNotificationHooks_Click"/>
                                            </Grid>

                                            <StackPanel Margin="0,0,0,12">
                                                <TextBlock x:Name="TxtNotificationStatus" Foreground="{DynamicResource ThemeSecondaryBrush}" FontSize="11" TextWrapping="Wrap"/>
                                                <Button x:Name="BtnNotificationAccess" Content="Доступ к уведомлениям Windows" Style="{StaticResource GlassPillBtn}" HorizontalAlignment="Left" Margin="0,6,0,0" Click="NotificationAccess_Click"/>
                                            </StackPanel>

                                            <StackPanel Margin="0,0,0,16">
                                                <TextBlock x:Name="LblNotificationDuration" Text="Время показа уведомления" Foreground="{DynamicResource ThemeTextBrush}" FontSize="13" FontWeight="SemiBold"/>
                                                <Grid Margin="0,8,0,0">
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="50"/></Grid.ColumnDefinitions>
                                                    <Slider x:Name="NotificationDurationSlider" Minimum="3" Maximum="10" Value="5" TickFrequency="1" IsSnapToTickEnabled="True"
                                                            VerticalAlignment="Center" ValueChanged="NotificationDurationSlider_ValueChanged" AutomationProperties.Name="Время показа уведомления от 3 до 10 секунд"/>
                                                    <TextBlock x:Name="NotificationDurationValue" Grid.Column="1" Text="5 с" Foreground="{DynamicResource ThemeAccentBrush}" TextAlignment="Right" VerticalAlignment="Center" FontWeight="Bold"/>
                                                </Grid>
                                            </StackPanel>

                                            <!-- 5. СИНХРОНИЗАЦИЯ И ИНДИКАЦИЯ «НЕ БЕСПОКОИТЬ» -->
                                            <Grid Margin="0,0,0,12">
                                                <StackPanel Margin="0,0,60,0">
                                                    <TextBlock x:Name="LblShowDnd" Text="Показывать «Не беспокоить» (синхронизация с Windows)" Foreground="{DynamicResource ThemeTextBrush}" FontSize="13" FontWeight="SemiBold"/>
                                                    <TextBlock x:Name="LblShowDndSub" Text="Двусторонняя синхронизация с системным режимом «Не беспокоить» в Windows" Foreground="{DynamicResource ThemeMutedBrush}" FontSize="11" TextWrapping="Wrap"/>
                                                </StackPanel>
                                                <CheckBox x:Name="TglShowDnd" Style="{StaticResource IslandSwitch}" IsChecked="True" HorizontalAlignment="Right" VerticalAlignment="Center" Click="SaveSettings_Click"/>
                                            </Grid>

                                            <Grid Margin="0,0,0,12">
                                                <TextBlock x:Name="LblDndActiveNow" Text="Режим «Не беспокоить» сейчас активен" Foreground="{DynamicResource ThemeTextBrush}" FontSize="13" VerticalAlignment="Center"/>
                                                <CheckBox x:Name="TglDndActiveState" Style="{StaticResource IslandSwitch}" IsChecked="False" HorizontalAlignment="Right" Click="TglDndActiveState_Click"/>
                                            </Grid>

                                            <Grid Margin="0,0,0,12">
                                                <StackPanel Margin="0,0,60,0">
                                                    <TextBlock x:Name="LblClipboardWatch" Text="Показывать скопированный текст (кроме паролей)" Foreground="{DynamicResource ThemeTextBrush}" FontSize="13" FontWeight="SemiBold"/>
                                                    <TextBlock x:Name="LblClipboardSub" Text="Автоматически игнорирует пароли, токены и ключи" Foreground="{DynamicResource ThemeMutedBrush}" FontSize="11"/>
                                                </StackPanel>
                                                <CheckBox x:Name="TglClipboardWatch" Style="{StaticResource IslandSwitch}" IsChecked="True" HorizontalAlignment="Right" Click="SaveSettings_Click"/>
                                            </Grid>

                                            <Grid Margin="0,0,0,12">
                                                <StackPanel Margin="0,0,60,0">
                                                    <TextBlock x:Name="LblCapture" Text="Скрывать остров на скриншотах и демонстрации экрана" Foreground="{DynamicResource ThemeTextBrush}" FontSize="13" FontWeight="SemiBold"/>
                                                    <TextBlock x:Name="LblCaptureSub" Text="Невидим в OBS, Discord, Zoom и на скриншотах" Foreground="{DynamicResource ThemeMutedBrush}" FontSize="11"/>
                                                </StackPanel>
                                                <CheckBox x:Name="TglExcludeCapture" Style="{StaticResource IslandSwitch}" IsChecked="True" HorizontalAlignment="Right" Click="TglExcludeCapture_Click"/>
                                            </Grid>

                                            <Grid Margin="0,0,0,12">
                                                <TextBlock x:Name="LblFullscreen" Text="Прятать в полноэкранных играх (если выключен игровой HUD)" Foreground="{DynamicResource ThemeTextBrush}" FontSize="13" VerticalAlignment="Center"/>
                                                <CheckBox x:Name="TglHideFullscreen" Style="{StaticResource IslandSwitch}" IsChecked="False" HorizontalAlignment="Right" Click="SaveSettings_Click"/>
                                            </Grid>

                                            <Grid Margin="0,0,0,12">
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock x:Name="LblHotkeyTitle" Text="Открывать остров клавишами" Foreground="{DynamicResource ThemeTextBrush}" FontSize="13" FontWeight="SemiBold"/>
                                                    <TextBlock x:Name="LblHotkeySub" Text="Нажмите на кнопку и зажмите любую комбинацию клавиш" Foreground="{DynamicResource ThemeMutedBrush}" FontSize="11"/>
                                                </StackPanel>
                                                <Button x:Name="HotkeyRecordBtn" Style="{StaticResource GlassPillBtn}" Background="{DynamicResource ThemeInputBrush}"
                                                        HorizontalAlignment="Right" VerticalAlignment="Center" Padding="14,7"
                                                        Click="HotkeyRecordBtn_Click" PreviewKeyDown="HotkeyRecordBtn_PreviewKeyDown">
                                                    <TextBlock x:Name="HotkeyDisplayText" Text="Ctrl + Alt + O" Foreground="{DynamicResource ThemeAccentBrush}" FontSize="12" FontWeight="Bold"/>
                                                </Button>
                                            </Grid>

                                            <Grid Margin="0,0,0,12">
                                                <TextBlock x:Name="LblStartup" Text="Запускать вместе с Windows" Foreground="{DynamicResource ThemeTextBrush}" FontSize="13" VerticalAlignment="Center"/>
                                                <CheckBox x:Name="TglRunOnStartup" Style="{StaticResource IslandSwitch}" IsChecked="False" HorizontalAlignment="Right" Click="TglRunOnStartup_Click"/>
                                            </Grid>

                                            <Grid Margin="0,0,0,16">
                                                <TextBlock x:Name="LblCleanDesktop" Text="Чистый рабочий стол: прятать значки" Foreground="{DynamicResource ThemeTextBrush}" FontSize="13" VerticalAlignment="Center"/>
                                                <CheckBox x:Name="TglHideDesktopIcons" Style="{StaticResource IslandSwitch}" IsChecked="False" HorizontalAlignment="Right" Click="TglHideDesktopIcons_Click"/>
                                            </Grid>

                                            <StackPanel Orientation="Horizontal">
                                                <Button x:Name="BtnCenterIsland" Style="{StaticResource GlassPillBtn}" Background="{DynamicResource ThemeAccentBrush}" Foreground="{DynamicResource ThemeOnAccentBrush}"
                                                        Content="＝  Выровнять по центру" Padding="16,8" Margin="0,0,10,0" Click="CenterIsland_Click"/>
                                                <Button x:Name="BtnResetAll" Style="{StaticResource GlassPillBtn}" Background="#38EF4444" Foreground="#FF7B7B"
                                                        Content="Сбросить настройки" Padding="16,8" Click="ResetSettings_Click"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>

                            <!-- СТРАНИЦА 6: ДЕЙСТВИЯ -->
                            <ScrollViewer x:Name="PageActions" Visibility="Collapsed" VerticalScrollBarVisibility="Hidden">
                                <Border Style="{StaticResource GlassSectionCard}">
                                    <StackPanel>
                                        <TextBlock x:Name="LblCustomCmdTitle" Text="Команда для кнопки «Команда»" Foreground="{DynamicResource ThemeTextBrush}" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                        <Border Background="{DynamicResource ThemeInputBrush}" CornerRadius="13" Padding="14,9" Margin="0,0,0,16">
                                            <TextBox x:Name="CustomCmdTextBox" Background="Transparent" Foreground="{DynamicResource ThemeTextBrush}" CaretBrush="{DynamicResource ThemeTextBrush}"
                                                     BorderThickness="0" FontSize="13" Text="wt.exe" TextChanged="CustomCmdTextBox_TextChanged"/>
                                        </Border>

                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                            <TextBlock x:Name="LblTranslateTarget" Text="Переводить на язык" Foreground="{DynamicResource ThemeTextBrush}" FontSize="13" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                            <Border Background="{DynamicResource ThemeInputBrush}" CornerRadius="12" Padding="12,6" Width="64">
                                                <TextBox x:Name="TranslateLangTextBox" Background="Transparent" Foreground="{DynamicResource ThemeTextBrush}" CaretBrush="{DynamicResource ThemeTextBrush}"
                                                         BorderThickness="0" FontSize="13" Text="ru" HorizontalContentAlignment="Center" TextChanged="CustomCmdTextBox_TextChanged"/>
                                            </Border>
                                        </StackPanel>

                                        <TextBlock x:Name="LblHotkeysHint" Text="Ctrl+Alt+S — скриншот области · Ctrl+Alt+R — запись · Ctrl+Alt+Space — командная строка"
                                                   Foreground="{DynamicResource ThemeMutedBrush}" FontSize="11.5" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>
                            </ScrollViewer>

                            <!-- СТРАНИЦА 7: ИИ-АГЕНТЫ -->
                            <ScrollViewer x:Name="PageAi" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <StackPanel>
                                    <Border Style="{StaticResource GlassSectionCard}">
                                        <StackPanel>
                                            <TextBlock x:Name="LblAiHeader" Text="ИИ-агенты" Foreground="{DynamicResource ThemeTextBrush}" FontSize="15" FontWeight="Bold" Margin="0,0,0,12"/>
                                            <TextBlock x:Name="AiGeminiTitle" Text="Голосовой ассистент · Gemini Live" Foreground="{DynamicResource ThemeTextBrush}" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                            <TextBlock x:Name="AiGeminiKeyLabel" Text="API-ключ Gemini" Foreground="{DynamicResource ThemeMutedBrush}" FontSize="11" Margin="0,0,0,4"/>
                                            <PasswordBox x:Name="AiGeminiKeyBox" Style="{StaticResource RoundedFeaturePasswordBox}" Background="{DynamicResource ThemeInputBrush}" Foreground="{DynamicResource ThemeTextBrush}"
                                                         BorderThickness="0" Padding="10" FontSize="13" Margin="0,0,0,8" AutomationProperties.LabeledBy="{Binding ElementName=AiGeminiKeyLabel}"/>
                                            <TextBlock x:Name="AiGeminiStatusText" Text="Ключ не задан. Можно использовать GEMINI_API_KEY." Foreground="{DynamicResource ThemeMutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,8"/>
                                            <WrapPanel>
                                                <Button x:Name="BtnAiGeminiSave" Style="{StaticResource GlassPillBtn}" Content="Сохранить ключ" Click="AiGeminiSave_Click"/>
                                                <Button x:Name="BtnAiGeminiDelete" Style="{StaticResource GlassPillBtn}" Content="Удалить ключ" Click="AiGeminiDelete_Click"/>
                                            </WrapPanel>
                                            <TextBlock x:Name="AiGeminiGainLabel" Text="Громкость ИИ-ассистента" Foreground="{DynamicResource ThemeTextBrush}" FontSize="12" FontWeight="SemiBold" Margin="0,12,0,4"/>
                                            <Slider x:Name="AiGeminiGainSlider" Minimum="0" Maximum="1" TickFrequency=".05" ValueChanged="AiGeminiGain_ValueChanged"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource GlassSectionCard}">
                                        <Grid>
                                            <StackPanel Margin="0,0,120,0">
                                                <TextBlock Text="Claude Code" Foreground="{DynamicResource ThemeTextBrush}" FontSize="13" FontWeight="SemiBold"/>
                                                <TextBlock x:Name="AiClaudeStatusText" Foreground="{DynamicResource ThemeMutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,8,0,0"/>
                                            </StackPanel>
                                            <Button x:Name="BtnAiClaude" Style="{StaticResource GlassPillBtn}" Content="Подключить" HorizontalAlignment="Right" VerticalAlignment="Top" Click="AiClaude_Click"/>
                                        </Grid>
                                    </Border>
                                    <Border Style="{StaticResource GlassSectionCard}">
                                        <Grid>
                                            <StackPanel Margin="0,0,120,0">
                                                <TextBlock Text="Codex (OpenAI)" Foreground="{DynamicResource ThemeTextBrush}" FontSize="13" FontWeight="SemiBold"/>
                                                <TextBlock x:Name="AiCodexStatusText" Foreground="{DynamicResource ThemeMutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,8,0,0"/>
                                            </StackPanel>
                                            <Button x:Name="BtnAiCodex" Style="{StaticResource GlassPillBtn}" Content="Подключить" HorizontalAlignment="Right" VerticalAlignment="Top" Click="AiCodex_Click"/>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>
                            <ScrollViewer x:Name="SettingsFeatureScroll" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <StackPanel x:Name="SettingsFeatureContent" Margin="0,0,8,8"/>
                            </ScrollViewer>
                        </Grid>
                    </Grid>
                </Grid>
            </Grid>
        </Border>

        <Button x:Name="HiddenIslandHandle" Grid.Column="1" Width="74" Height="14" Margin="0,4,0,0"
                HorizontalAlignment="Center" VerticalAlignment="Top" Visibility="Collapsed" Cursor="Hand"
                ToolTip="Показать островок" Click="HiddenIslandHandle_Click">
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Border Background="Transparent">
                        <Border x:Name="HandleBar" Height="8" VerticalAlignment="Top" CornerRadius="4"
                                Background="{DynamicResource ThemeCapsuleBrush}" BorderBrush="{DynamicResource ThemeMutedBrush}" BorderThickness="1"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="HandleBar" Property="BorderBrush" Value="{DynamicResource ThemeAccentBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Button.Template>
        </Button>

        <!-- ПРАВАЯ КОЛОНКА (Col 2): ОТДЕЛЬНЫЙ ОСТРОВОК ЗВОНКА DISCORD + БОКОВАЯ КАПСУЛА УВЕДОМЛЕНИЙ -->
        <StackPanel x:Name="RightCapsuleStack" Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10,10,0,0">
                    <Border x:Name="CompactProgressPanel" Visibility="Collapsed" Background="{DynamicResource ThemeCapsuleBrush}" CornerRadius="12" Padding="8,2" Height="38" Width="190" Margin="0,0,8,0" BorderThickness="1" BorderBrush="{DynamicResource GlassEdgeBrush}" MouseLeftButtonUp="Progress_Click" Cursor="Hand">
                        <Grid VerticalAlignment="Center"><Grid.ColumnDefinitions><ColumnDefinition Width="30"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Grid Width="24" Height="24"><Ellipse Stroke="{DynamicResource ThemeBorderBrush}" StrokeThickness="2" Margin="2"/><Path x:Name="CompactProgressRing" Stroke="{DynamicResource ThemeAccentBrush}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/></Grid>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock x:Name="CompactProgressLabel" Foreground="{DynamicResource ThemeTextBrush}" FontSize="11" TextTrimming="CharacterEllipsis"/><ProgressBar x:Name="CompactProgressBar" Visibility="Collapsed" Maximum="100"/></StackPanel>
                        </Grid>
                    </Border>
            <Border x:Name="LevelHudBorder" Visibility="Collapsed" Background="{DynamicResource ThemeCapsuleBrush}" BorderBrush="{DynamicResource GlassEdgeBrush}" BorderThickness="1" CornerRadius="16" Padding="12,7" Margin="0,0,8,0" Width="200" PreviewMouseWheel="VolumeHud_MouseWheel">
                <StackPanel>
                    <Grid>
                        <TextBlock x:Name="LevelHudText" Foreground="{DynamicResource ThemeTextBrush}" FontSize="11" VerticalAlignment="Center" Margin="0,0,25,0"/>
                        <Button x:Name="VolumeMuteButton" Style="{StaticResource GlassPillBtn}" HorizontalAlignment="Right" Padding="3,0" Content="&#xE767;" FontFamily="Segoe MDL2 Assets" ToolTip="Выключить звук" Click="VolumeMute_Click"/>
                    </Grid>
                    <Slider x:Name="VolumeHudSlider" Minimum="0" Maximum="100" TickFrequency="1" IsSnapToTickEnabled="True" IsMoveToPointEnabled="True" Height="20" Margin="0,3,0,0" Foreground="{DynamicResource ThemeAccentBrush}" ValueChanged="VolumeHudSlider_ValueChanged" AutomationProperties.Name="Volume"/>
                    <ProgressBar x:Name="LevelHudBar" Maximum="100" Height="4" Margin="0,5,0,0" Foreground="{DynamicResource ThemeAccentBrush}" Background="{DynamicResource ThemeInputBrush}"/>
                </StackPanel>
            </Border>

            <Border x:Name="DiscordCallBorder" Height="48" Width="140" CornerRadius="24"
                    Background="{DynamicResource ThemeCapsuleBrush}" BorderThickness="1" BorderBrush="{DynamicResource GlassEdgeBrush}"
                    UseLayoutRounding="True" SnapsToDevicePixels="True" Margin="0,0,8,0" Visibility="Collapsed">
                <Grid>
                    <Border x:Name="DiscordGlassOverlay" CornerRadius="24" Background="{DynamicResource GlassSheenBrush}" IsHitTestVisible="False"/>
                    <Grid Margin="5,0" VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="34"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="38"/>
                        </Grid.ColumnDefinitions>
                        <Button x:Name="DiscordOutputButton" Style="{StaticResource GlassPillBtn}" Width="30" Height="30" Padding="0"
                                Background="#5865F2" Foreground="White" Click="DiscordOutput_Click">
                            <Path Width="15" Height="15" Stretch="Uniform" Stroke="White" StrokeThickness="1.25"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                  Data="M2,9 V8 A6,6 0 0 1 14,8 V9 M2,9 H5 V14 H3 Q2,14 2,13 Z M14,9 H11 V14 H13 Q14,14 14,13 Z"/>
                        </Button>
                        <Button x:Name="DiscordTimerButton" Grid.Column="1" Style="{StaticResource GlassPillBtn}" Height="30"
                                Background="Transparent" Padding="2,0" Click="DiscordCallTimer_Click">
                            <TextBlock x:Name="DiscordCallTimerText" Text="0:00" FontSize="13" FontWeight="Bold" VerticalAlignment="Center"/>
                        </Button>
                        <Button x:Name="DiscordMicButton" Grid.Column="2" Style="{StaticResource GlassPillBtn}" Width="30" Height="30"
                                Padding="0" Background="Transparent" IsEnabled="False" Click="DiscordMic_Click">
                            <Grid Width="16" Height="16">
                                <Path x:Name="DiscordMicIcon" Stroke="{DynamicResource ThemeTextBrush}" StrokeThickness="1.1"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                      Data="M6,3 A2,2 0 0 1 10,3 V8 A2,2 0 0 1 6,8 Z M3.5,7.5 V8 A4.5,4.5 0 0 0 12.5,8 V7.5 M8,12.5 V15 M6,15 H10"/>
                                <Path x:Name="DiscordMicSlash" Visibility="Collapsed" Stroke="{DynamicResource ThemeDangerBrush}"
                                      StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M2,2 L14,14"/>
                            </Grid>
                        </Button>
                    </Grid>
                </Grid>
            </Border>

            <Border x:Name="SideToastBorder"
                    Height="38"
                    CornerRadius="19"
                    Background="{DynamicResource ThemeCapsuleBrush}"
                    BorderThickness="1" BorderBrush="{DynamicResource GlassEdgeBrush}"
                    UseLayoutRounding="True"
                    SnapsToDevicePixels="True"
                    Padding="0"
                    Visibility="Collapsed"
                    Opacity="0"
                    MouseLeftButtonUp="SideToastBorder_MouseLeftButtonUp"
                    RenderTransformOrigin="0,0">

                <Border.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform x:Name="SideToastScale" ScaleX="1.0" ScaleY="1.0"/>
                        <TranslateTransform x:Name="SideToastSlide" X="-14"/>
                    </TransformGroup>
                </Border.RenderTransform>

                <Grid>
                    <Border x:Name="SideToastGlassOverlay" CornerRadius="19" Background="{DynamicResource GlassSheenBrush}" IsHitTestVisible="False"/>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="7,0,15,0">
                    <Border x:Name="SideToastIconCircle" Width="24" Height="24" CornerRadius="12" Background="#FF9F1C" Margin="0,0,9,0" VerticalAlignment="Center">
                        <Grid>
                            <Path x:Name="SideToastVectorIcon"
                                  Data="M12,8L6,14H10V18H14V14H18L12,8M6,20H18V22H6V20Z"
                                  Fill="{DynamicResource IconOnAccentBrush}" Width="13" Height="13" Stretch="Uniform"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <Image x:Name="SideToastAppIcon" Width="22" Height="22" Stretch="Uniform" Visibility="Collapsed"/>
                            <TextBlock x:Name="SideToastBadgeShortText" Text="" Foreground="{DynamicResource IconOnAccentBrush}" FontSize="9" FontWeight="ExtraBold"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
                        </Grid>
                    </Border>

                    <TextBlock x:Name="SideToastText"
                               Text="Caps Lock включён"
                               Foreground="{DynamicResource ThemeTextBrush}"
                               FontSize="12.5"
                               FontWeight="Bold"
                               MaxWidth="270"
                               TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center"/>
                </StackPanel>
                </Grid>
            </Border>
        </StackPanel>
    </Grid>
</Window>
