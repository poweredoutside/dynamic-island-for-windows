<Window x:Class="DynamicIslandWin.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:DynamicIslandWin"
        Title="OC - Dynamic Island"
        Width="1360" Height="700"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        Loaded="Window_Loaded"
        Closing="Window_Closing"
        Closed="Window_Closed">

    <Window.Resources>
        <ResourceDictionary>
        <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="ThemeResources.xaml"/><ResourceDictionary Source="IslandControls.xaml"/></ResourceDictionary.MergedDictionaries>
        <StreamGeometry x:Key="PlayerOutputGlyph">M2,9 V8 A6,6 0 0 1 14,8 V9 M2,9 H5 V14 H3 Q2,14 2,13 Z M14,9 H11 V14 H13 Q14,14 14,13 Z</StreamGeometry>
        <Style TargetType="Slider">
            <Setter Property="IsMoveToPointEnabled" Value="True"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid Background="Transparent" Margin="7,0">
                            <Border Height="4" CornerRadius="2" Background="{DynamicResource ThemeBorderBrush}" VerticalAlignment="Center"/>
                            <Track x:Name="PART_Track" IsDirectionReversed="{TemplateBinding IsDirectionReversed}">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge" Focusable="False">
                                        <RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Height="4" CornerRadius="2" Background="{DynamicResource ThemeAccentBrush}" VerticalAlignment="Center"/></ControlTemplate></RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Width="14" Height="14" Cursor="Hand">
                                        <Thumb.Template><ControlTemplate TargetType="Thumb"><Ellipse Fill="{DynamicResource ThemeAccentBrush}" Stroke="{DynamicResource ThemePopupBrush}" StrokeThickness="2"/></ControlTemplate></Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge" Focusable="False">
                                        <RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate></RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="IslandSwitch" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Width" Value="46"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="SwitchTrack" CornerRadius="12" Width="46" Height="24" Padding="3" Background="{DynamicResource ThemeInputBrush}">
                            
                            <Ellipse Width="18" Height="18" Fill="{DynamicResource ThemeThumbBrush}" HorizontalAlignment="Left">
                                <Ellipse.RenderTransform>
                                    <TranslateTransform x:Name="ThumbTranslate" X="0"/>
                                </Ellipse.RenderTransform>
                            </Ellipse>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="SwitchTrack" Property="Background" Value="{DynamicResource ThemeAccentBrush}"/>
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="ThumbTranslate" Storyboard.TargetProperty="X" To="22" Duration="0:0:0.20"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="ThumbTranslate" Storyboard.TargetProperty="X" To="0" Duration="0:0:0.20"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="MintChipToggle" TargetType="ToggleButton">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeSecondaryBrush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,8,8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Chip" Background="{DynamicResource ThemeInputBrush}" CornerRadius="14" Padding="13,7">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path x:Name="Chk" Data="M4,10 L8,14 L16,6" Stroke="{DynamicResource ThemeOnAccentBrush}" StrokeThickness="2.2"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                      Width="13" Height="13" Stretch="Uniform" Margin="0,0,6,0" Visibility="Collapsed"/>
                                <ContentPresenter VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Chk" Property="Visibility" Value="Visible"/>
                                <Setter Property="Foreground" Value="{DynamicResource ThemeOnAccentBrush}"/>
                                <Setter TargetName="Chip" Property="Background" Value="#34F5C5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GlassPillBtn" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextBrush}"/>
            <Setter Property="Background" Value="{DynamicResource ThemeInputBrush}"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="14" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#46FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PlayerSlider" TargetType="Slider">
            <Setter Property="Height" Value="20"/>
            <Setter Property="SmallChange" Value="1"/>
            <Setter Property="TickFrequency" Value="1"/>
            <Setter Property="IsSnapToTickEnabled" Value="True"/>
            <Setter Property="IsMoveToPointEnabled" Value="True"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid Background="Transparent">
                            <Border Height="4" Margin="5,0" CornerRadius="2" Background="{DynamicResource ThemeBorderBrush}"/>
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge" Focusable="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Background="Transparent">
                                                    <Border Height="4" Margin="5,0,-5,0" CornerRadius="2" Background="{DynamicResource ThemeAccentBrush}"/>
                                                </Border>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge" Focusable="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Background="Transparent"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Width="11">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Grid Background="Transparent">
                                                    <Ellipse Width="11" Height="11" Fill="{DynamicResource ThemeAccentBrush}"/>
                                                </Grid>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="PART_Track" Property="Opacity" Value=".45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SidebarNavBtn" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeSecondaryBrush}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Margin" Value="0,0,0,2"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="14" Padding="10,0,8,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="24"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{TemplateBinding Tag}" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"/>
                                <ContentPresenter Grid.Column="1" Margin="4,0,0,0" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource ThemeTextBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GlassSectionCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource ThemeSurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="18"/>
            <Setter Property="Padding" Value="16,14"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>

        <Style x:Key="WeatherTileCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource ThemeSurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="18"/>
            <Setter Property="Padding" Value="14,11"/>
            <Setter Property="Margin" Value="5"/>
        </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Background="{x:Null}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ГЛАВНАЯ КАПСУЛА ОСТРОВА (По центру) -->
        <Image x:Name="IslandShadow" Grid.Column="1" IsHitTestVisible="False"
               Visibility="{Binding Visibility, ElementName=IslandBorder}"
               RenderTransform="{Binding RenderTransform, ElementName=IslandBorder}" RenderTransformOrigin="0.5,0"
               Opacity="{Binding Opacity, ElementName=IslandBorder}"
               HorizontalAlignment="Center" VerticalAlignment="Top" Margin="-28,-18,-28,-28"
               Stretch="Fill"/>
        <Border x:Name="IslandBorder"
                Grid.Column="1"
                Width="210" Height="38"
                CornerRadius="19"
                BorderThickness="1" BorderBrush="{DynamicResource GlassEdgeBrush}"
                UseLayoutRounding="True"
                SnapsToDevicePixels="True"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Margin="0,10,0,0"
                ClipToBounds="True"
                RenderTransformOrigin="0.5,0"
                MouseEnter="IslandBorder_MouseEnter"
                MouseLeave="IslandBorder_MouseLeave"
                MouseMove="IslandBorder_MouseMove"
                MouseLeftButtonDown="IslandBorder_MouseLeftButtonDown"
                MouseLeftButtonUp="IslandBorder_MouseLeftButtonUp">

            <Border.RenderTransform>
                <ScaleTransform x:Name="IslandScaleTransform" ScaleX="1.0" ScaleY="1.0"/>
            </Border.RenderTransform>

            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop x:Name="GradStop1" Color="#F511131C" Offset="0"/>
                    <GradientStop x:Name="GradStop2" Color="#F51B1E2E" Offset="0.5"/>
                    <GradientStop x:Name="GradStop3" Color="#F50E1018" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>

            <Border.ContextMenu>
                <ContextMenu Style="{StaticResource IslandContextMenu}" ItemContainerStyle="{StaticResource IslandMenuItem}" Opened="IslandContextMenu_Opened">
                    <MenuItem Header="Спрятать островок" Tag="&#xE70E;" Click="CtxHideUp_Click"/>
                    <MenuItem Header="Выровнять по центру" Tag="&#xE8E3;" Click="CenterIsland_Click"/>
                    <MenuItem x:Name="CtxPinIsland" Header="Закрепить на месте" Tag="&#xE718;" IsCheckable="True" Click="PinIsland_Click"/>
                    <MenuItem x:Name="CtxDockIsland" Header="У верхнего края (macOS)" Tag="&#xE73F;" IsCheckable="True" Click="DockIsland_Click"/>
                    <MenuItem x:Name="CtxCheckUpdates" Header="Проверить обновления" Tag="&#xE895;" Click="CtxCheckUpdates_Click"/>
                    <MenuItem Header="Изменить размер…" Tag="&#xE740;" Click="StartManualResize"/>
                    <MenuItem Header="Громкость" Tag="&#xE767;" Click="OpenVolume_Click"/>
                    <Separator Style="{StaticResource IslandMenuSeparator}"/>
                    <MenuItem x:Name="CtxGameModeItem" Header="Игровой режим" Tag="&#xE7FC;" Click="CtxToggleGameMode_Click"/>
                    <MenuItem Header="Игровой центр" Tag="&#xE713;" Click="CtxOpenGameCenter_Click"/>
                    <Separator Style="{StaticResource IslandMenuSeparator}"/>
                    <MenuItem Header="Настройки" Tag="&#xE713;" Click="OpenSettingsBtn_Click"/>
                    <MenuItem Header="Выйти" Tag="&#xE7E8;" Foreground="{DynamicResource ThemeDangerBrush}" Click="ExitMenu_Click"/>
                </ContextMenu>
            </Border.ContextMenu>

            <Grid x:Name="IslandSurfaceLayer">
                <Canvas x:Name="LiquidGlassLayer" IsHitTestVisible="False">
                    <Image x:Name="LiquidGlassBackdrop" IsHitTestVisible="False" Stretch="Fill" Visibility="Collapsed"
                           Width="{Binding ActualWidth, ElementName=LiquidGlassLayer}" Height="{Binding ActualHeight, ElementName=LiquidGlassLayer}"/>
                </Canvas>
                <Border x:Name="CustomBgBorder" CornerRadius="19" Opacity="0.32" IsHitTestVisible="False">
                    <Border.Background>
                        <ImageBrush x:Name="CustomBgBrush" Stretch="UniformToFill"/>
                    </Border.Background>
                </Border>

                <Border x:Name="LiquidGlassOverlay" CornerRadius="19" IsHitTestVisible="False" Visibility="Visible">
                    <Grid IsHitTestVisible="False">
                        <Border CornerRadius="{Binding CornerRadius, ElementName=LiquidGlassOverlay}" Background="{DynamicResource GlassSheenBrush}"/>
                        <Border x:Name="GlassSpecularBorder" CornerRadius="{Binding CornerRadius, ElementName=LiquidGlassOverlay}" Opacity="0.32">
                            <Border.Background>
                                <RadialGradientBrush x:Name="GlassSpecularBrush" Center="0.2,0" GradientOrigin="0.2,0" RadiusX="0.7" RadiusY="1">
                                    <GradientStop Color="#88FFFFFF" Offset="0"/>
                                    <GradientStop Color="#00FFFFFF" Offset="1"/>
                                </RadialGradientBrush>
                            </Border.Background>
                        </Border>
                    </Grid>
                </Border>

                <local:SnowfallLayer x:Name="IslandSnowfall" Visibility="Collapsed" IsHitTestVisible="False" ClipToBounds="True"/>

                <!-- 1. КОМПАКТНЫЙ РЕЖИМ -->
                <Grid x:Name="CompactView" Visibility="Visible" Margin="12,0">
                    <!-- 1А. Обычный вид (меняет размер ползунком) -->
                    <Grid x:Name="CompactStandardPanel" Visibility="Visible" Margin="2,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <ContentControl x:Name="CompactCharacterHost" Width="22" Height="22" VerticalAlignment="Center"/>
                            <Border x:Name="CompactDndBadge" Background="#38A78BFA" CornerRadius="8" Padding="4,2" Margin="6,0,0,0" Visibility="Collapsed" VerticalAlignment="Center">
                                <Path Data="M18.97,15.95C19.8,15.87 20.69,17.05 20.16,17.8C19.84,18.25 19.5,18.67 19.08,19.07C15.17,23 8.84,23 4.94,19.07C1.03,15.17 1.03,8.83 4.94,4.93C5.34,4.53 5.76,4.17 6.21,3.85C6.96,3.32 8.14,4.21 8.06,5.04C7.79,7.9 8.75,10.87 10.95,13.06C13.14,15.26 16.1,16.22 18.97,15.95Z"
                                      Fill="#C4B5FD" Width="10" Height="10" Stretch="Uniform"/>
                            </Border>
                        </StackPanel>

                        <TextBlock x:Name="CompactClockText" Grid.Column="1" Text="21:43"
                                   Foreground="{DynamicResource ThemeTextBrush}" FontSize="13.5" FontWeight="Bold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>

                        <StackPanel Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center">
                            <TextBlock x:Name="CompactTrackText" Visibility="Collapsed"
                                       Foreground="{DynamicResource ThemeTextBrush}" FontSize="13" FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                            <TextBlock x:Name="CompactLyricsText" Visibility="Collapsed" Margin="0,2,0,0"
                                       Foreground="{DynamicResource ThemeSecondaryBrush}" FontSize="13"
                                       TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                            <TextBlock x:Name="CompactNextLyric" Visibility="Collapsed"
                                       Foreground="{DynamicResource ThemeMutedBrush}" FontSize="11"
                                       TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                            <TextBlock x:Name="CompactLastLyric" Visibility="Collapsed"
                                       Foreground="{DynamicResource ThemeMutedBrush}" FontSize="11"
                                       TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                        </StackPanel>

                        <StackPanel x:Name="CompactWeatherPanel" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Data="M6,19A5,5 0 0,1 1,14A5,5 0 0,1 6,9C7,6.65 9.3,5 12,5C15.43,5 18.24,7.66 18.5,11.03L19,11A4,4 0 0,1 23,15A4,4 0 0,1 19,19H6Z"
                                  Fill="#8AB4F8" Width="13" Height="13" Stretch="Uniform" Margin="0,0,5,0" VerticalAlignment="Center"/>
                            <TextBlock x:Name="CompactTempText" Text="--°" Foreground="{DynamicResource ThemeTextBrush}" FontSize="13" FontWeight="Bold" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock x:Name="CompactBatteryText" Grid.Column="2" Visibility="Collapsed" VerticalAlignment="Center"
                                   Foreground="{DynamicResource ThemeTextBrush}" FontSize="12"/>
                    </Grid>

                    <!-- Compact game center: stable metric cards, independent of user scale. -->
                    <StackPanel x:Name="CompactGameHudPanel" Visibility="Collapsed" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Border Background="{DynamicResource ThemeSelectionBrush}" BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="1" CornerRadius="12" Width="34" Height="46" Margin="0,0,8,0" ToolTip="Игровой центр">
                            <ContentControl x:Name="GameHudCharacterHost" Width="22" Height="22" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Border>
                        <Border x:Name="GameHudFpsCard" Style="{StaticResource GameMetricCard}" Width="90" Background="{DynamicResource ThemeSelectionBrush}">
                            <StackPanel>
                                <TextBlock x:Name="GameHudFpsLabel" Style="{StaticResource GameMetricLabel}" Text="FPS"/>
                                <TextBlock x:Name="GameHudFpsText" Style="{StaticResource GameMetricValue}" Text="—" Foreground="{DynamicResource ThemeAccentBrush}"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource GameMetricCard}" ToolTip="Загрузка процессора">
                            <StackPanel>
                                <TextBlock Style="{StaticResource GameMetricLabel}" Text="CPU"/>
                                <TextBlock x:Name="GameHudCpuText" Style="{StaticResource GameMetricValue}" Text="18%"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource GameMetricCard}" ToolTip="Температура процессора">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Path x:Name="GameHudTempIcon" Data="M15,13V5A3,3 0 0,0 12,2A3,3 0 0,0 9,5V13A5,5 0 0,0 7,17A5,5 0 0,0 12,22A5,5 0 0,0 17,17A5,5 0 0,0 15,13M12,4A1,1 0 0,1 13,5V8H11V5A1,1 0 0,1 12,4Z" Fill="{DynamicResource ThemeMutedBrush}" Width="6" Height="9" Stretch="Uniform" Margin="0,0,4,2"/>
                                    <TextBlock Style="{StaticResource GameMetricLabel}" Text="CPU °C"/>
                                </StackPanel>
                                <TextBlock x:Name="GameHudCpuTempText" Style="{StaticResource GameMetricValue}" Text="—"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource GameMetricCard}" ToolTip="Загрузка графики">
                            <StackPanel>
                                <TextBlock Style="{StaticResource GameMetricLabel}" Text="GPU"/>
                                <TextBlock x:Name="GameHudGpuText" Style="{StaticResource GameMetricValue}" Text="42%"/>
                            </StackPanel>
                        </Border>
                        <Border Background="{DynamicResource ThemeSelectionBrush}" CornerRadius="10" Width="28" Height="28" Margin="2,0,0,0" VerticalAlignment="Center" ToolTip="Уведомления приостановлены на время игры">
                            <Path Data="M18.97,15.95C19.8,15.87 20.69,17.05 20.16,17.8C19.84,18.25 19.5,18.67 19.08,19.07C15.17,23 8.84,23 4.94,19.07C1.03,15.17 1.03,8.83 4.94,4.93C5.34,4.53 5.76,4.17 6.21,3.85C6.96,3.32 8.14,4.21 8.06,5.04C7.79,7.9 8.75,10.87 10.95,13.06C13.14,15.26 16.1,16.22 18.97,15.95Z" Fill="{DynamicResource ThemeAccentBrush}" Width="12" Height="12" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </StackPanel>
                </Grid>

                <!-- 2. РЕЖИМ ПРИ НАВЕДЕНИИ (HOVER) -->
                <Grid x:Name="HoverView" Visibility="Collapsed" Margin="16,0" Opacity="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <ContentControl x:Name="HoverCharacterHost" Width="28" Height="28" VerticalAlignment="Center"/>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0">
                        <TextBlock x:Name="HoverTrackTitle" Text="OC - Dynamic Island" Foreground="{DynamicResource ThemeTextBrush}" FontSize="12" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
                        <TextBlock x:Name="HoverTrackArtist" Text="Click to expand hub" Foreground="{DynamicResource ThemeSecondaryBrush}" FontSize="10" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>

                    <TextBlock x:Name="HoverSysText" Grid.Column="2" Text="FPS —" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource ThemeSecondaryBrush}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,10,0"/>

                    <Button Grid.Column="3" Style="{StaticResource GlassPillBtn}" Padding="10,5" Click="OpenSettingsBtn_Click">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="M12,8A4,4 0 0,1 16,12A4,4 0 0,1 12,16A4,4 0 0,1 8,12A4,4 0 0,1 12,8M10,22L9.13,18.93L7.44,17.94L4.34,18.73L2.34,15.27L4.57,12.97L4.5,12L4.57,11L2.34,8.73L4.34,5.27L7.44,6.05L9.13,5.07L10,2H14L14.87,5.07L16.56,6.05L19.66,5.27L21.66,8.73L19.43,11L19.5,12L19.43,12.97L21.66,15.27L19.66,18.73L16.56,17.94L14.87,18.93L14,22H10Z"
                                  Fill="{DynamicResource ThemeTextBrush}" Width="13" Height="13" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock x:Name="HoverSettingsText" Text="Settings" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </Grid>

                <Grid x:Name="DashboardHeader" Visibility="Collapsed" Height="32" Margin="20,14,20,0" VerticalAlignment="Top" Panel.ZIndex="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel x:Name="DashboardNavigation" Orientation="Horizontal" VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
                        <TextBlock x:Name="DashboardFpsText" Style="{StaticResource GamePageFps}"/>
                        <ContentControl x:Name="ExpandedCharacterHost" Width="24" Height="24" VerticalAlignment="Center" Margin="0,0,6,0"/>
