<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Version>1.1.9</Version>
    <Title>OC - Dynamic Island</Title>
    <Product>OC - Dynamic Island</Product>
    <Description>OC - Dynamic Island для Windows</Description>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="tests\**;installer\**;broker\**;artifacts\**;.tools\**" />
    <EmbeddedResource Remove="tests\**;installer\**;broker\**;artifacts\**;.tools\**" />
    <None Remove="artifacts\**;.tools\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="LibreHardwareMonitorLib" Version="0.9.6" />
    <PackageReference Include="NAudio" Version="2.2.1" />
    <PackageReference Include="Ical.Net" Version="4.3.1" />
    <PackageReference Include="System.Management" Version="10.0.2" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
    <PackageReference Include="Microsoft.Diagnostics.Tracing.TraceEvent" Version="3.1.21" />
  </ItemGroup>
  <ItemGroup><Content Include="THIRD_PARTY_NOTICES.md;licenses\**" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" /></ItemGroup>
  <ItemGroup Condition="Exists('.tools\hardware\PawnIO_setup.exe')">
    <Content Include=".tools\hardware\PawnIO_setup.exe" Link="Hardware\PawnIO_setup.exe" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
